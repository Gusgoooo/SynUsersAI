# Default server-side model configuration.
# Users can also open SynUsersAI and use the top-right "Model / BYOK" panel
# to provide their own API key for the current browser session.

LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional Gemini-compatible generateContent endpoint.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-pro

# Optional Routify Vertex-style route for local/internal use.
# GEMINI_API_URL=https://routify.alibaba-inc.com/protocol/vertex/v1beta
# GEMINI_MODEL=gemini-3-pro-preview

# Optional live web research for topic/persona intersection.
# If configured, the simulator searches the web before chat, then distills results
# into each persona's familiarity, relevance, likely misunderstandings, and decision angles.
# Supported providers: tavily, brave, serper
WEB_RESEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_COUNTRY=us
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_TIMEOUT_MS=10000
TOPIC_PREPARATION_TIMEOUT_MS=45000

# Provider-specific key aliases also work:
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
